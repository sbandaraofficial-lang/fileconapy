/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model where all
 * data is privately owned and managed by the user who created it. There are no
 * public or shared data collections.
 *
 * Data Structure: The data is organized hierarchically. Each user has a root
 * document in the `/users` collection. All of their private data, such as file
 * metadata, is stored in subcollections under their specific user document (e.g.,
 * `/users/{userId}/files/{fileId}`).
 *
 * Key Security Decisions:
 * - User Isolation: A user can ONLY read or write their own data. They cannot
 *   access, or even know about, the data of other users.
 * - No User Listing: Listing documents from the top-level `/users` collection is
 *   explicitly disabled to protect user privacy and prevent enumeration attacks.
 * - Path-Based Security: Authorization is primarily determined by the `{userId}`
 *   wildcard in the document path. This is efficient as it avoids extra database
 *   reads (`get()` calls) to check for ownership.
 *
 * Denormalization for Authorization: The data structure is designed to be
 * authorization-first. By nesting user-specific data in subcollections, the
 * user's ID (`userId`) becomes part of the path itself, making ownership checks
 * fast and simple. For documents within these subcollections (like a 'File'), an
 * internal `userId` field is also required upon creation to ensure a permanent,
 * immutable link back to the owner, which is validated by the rules.
 *
 * Structural Segregation: User profile data (`/users/{userId}`) is structurally
 * separate from user-owned content (`/users/{userId}/files/{fileId}`). This
 * creates a clear boundary and allows for distinct security rules if needed in
 * the future, even though both currently follow a strict ownership model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the primary function for enforcing the ownership model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * A robust check for update/delete operations, ensuring the user is the owner
     * AND the document they are trying to modify actually exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Manages user profile documents. A user can create, read, and
     *   update their own profile, but cannot see other user profiles. Deletion
     *   is disallowed for safety.
     * @path /users/{userId}
     * @allow (create) A newly authenticated user creates their own profile document.
     *   `auth.uid == 'user_abc'`, `create /users/user_abc`
     * @deny (list) An authenticated user tries to list all users in the system.
     *   `auth.uid == 'user_abc'`, `list /users`
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Manages file metadata documents, which are nested under the
     *   user who owns them. Only the owner can perform any operation on their files.
     * @path /users/{userId}/files/{fileId}
     * @allow (create) An authenticated user uploads a new file metadata document.
     *   `auth.uid == 'user_abc'`, `create /users/user_abc/files/file_123`
     * @deny (get) An attacker tries to read file metadata belonging to another user.
     *   `auth.uid == 'attacker_xyz'`, `get /users/user_abc/files/file_123`
     * @principle Enforces strict document ownership within a user-specific subcollection.
     */
    match /users/{userId}/files/{fileId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}